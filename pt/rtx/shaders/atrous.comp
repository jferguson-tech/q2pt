#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// One pass of the spatial filter: each pixel's light is averaged with that
// of pixels around it that show the same surface and are lit alike. Run a
// few times with the taps spread twice as far each time ("a trous"), it
// reaches a long way for the cost of a small one. How readily neighbours are
// let in depends on how many frames stand behind a pixel: little history
// means noise, which wants smoothing; a lot means the value can be trusted.

layout(local_size_x = 8, local_size_y = 8) in;

#include "scene.glsl"

layout(push_constant) uniform Pass
{
	int		source;		// 0: what was gathered over time; 1, 2: the filter's own two sets
	int		target;		// 0, 1: which of the filter's sets to write
	int		spread;		// pixels between taps
	int		unused;
} pass;

vec4 Load(int k, ivec2 q)
{
	if (pass.source == 0)
		return imageLoad(img_kept[fr.frame_has.z * 3 + k], q);
	return imageLoad(img_filter[(pass.source - 1) * 3 + k], q);
}

void main()
{
	const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	const ivec2 size = fr.size.xy;
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;
	const int now = fr.frame_has.z;

	const vec4 surface = imageLoad(img_surface[now], pixel);
	vec4 centre[3];
	for (int k = 0; k < 3; k++)
		centre[k] = Load(k, pixel);
	if (surface.a < 0.0)
	{
		for (int k = 0; k < 3; k++)
			imageStore(img_filter[pass.target * 3 + k], pixel, centre[k]);
		return;
	}

	const float roughness = imageLoad(img_seen, pixel).a;
	// how far apart two pixels' light may be and still be averaged, as a
	// share of the light itself. Each channel has a history of its own:
	// reflections are followed where they appear to be, and the light of
	// the layers in front, where there are any, is counted apart.
	float tolerance[3];
	for (int k = 0; k < 3; k++)
	{
		const float frames = max(centre[k].a > 0.0 ? centre[k].a : centre[0].a, 1.0);
		tolerance[k] = max(Luminance(centre[k].rgb), 0.02) * 4.0 / sqrt(frames);
	}
	// a sharp reflection is a picture in itself and must not be smeared
	tolerance[1] *= clamp(roughness * 4.0, 0.05, 1.0);

	const float kernel[3] = float[3](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);
	vec3 sum[3] = vec3[3](vec3(0.0), vec3(0.0), vec3(0.0));
	float wsum[3] = float[3](0.0, 0.0, 0.0);

	for (int dy = -2; dy <= 2; dy++)
	{
		for (int dx = -2; dx <= 2; dx++)
		{
			const ivec2 q = pixel + ivec2(dx, dy) * pass.spread;
			if (q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y)
				continue;
			const vec4 other = imageLoad(img_surface[now], q);
			if (other.a < 0.0)
				continue;

			float w = kernel[abs(dx)] * kernel[abs(dy)];
			// the same way up, and about as far off
			const float facing = max(dot(surface.xyz, other.xyz), 0.0);
			w *= facing * facing;
			w *= facing * facing;
			w *= facing * facing;
			w *= facing * facing;
			w *= exp(-abs(other.a - surface.a) / (0.03 * surface.a + 0.5));
			if (w <= 1.0e-5)
				continue;

			for (int k = 0; k < 3; k++)
			{
				const vec3 c = Load(k, q).rgb;
				const float wk = w * exp(-abs(Luminance(c) - Luminance(centre[k].rgb)) / tolerance[k]);
				sum[k] += c * wk;
				wsum[k] += wk;
			}
		}
	}

	for (int k = 0; k < 3; k++)
		imageStore(img_filter[pass.target * 3 + k], pixel,
			vec4(wsum[k] > 0.0 ? sum[k] / wsum[k] : centre[k].rgb, centre[k].a));
}
