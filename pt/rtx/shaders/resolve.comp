#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// The last step: the glow is added, the picture graded for the screen, and
// its edges smoothed by blending each pixel with what the same point of the
// scene looked like in the frames before, each of which saw it through a
// slightly different part of the pixel.

layout(local_size_x = 8, local_size_y = 8) in;

#include "scene.glsl"

layout(push_constant) uniform Pass
{
	int		glow;		// there is a blurred glow to add
	int		unused0, unused1, unused2;
} pass;

vec3 ToneMap(vec3 c)
{
	const vec3 x = max(c, vec3(0.0));
	vec3 y;
	if (fr.output_i.x == 1)			// rolls off gently towards white at 4
		y = x * (1.0 + x * (1.0 / 16.0)) / (1.0 + x);
	else if (fr.output_i.x == 2)	// clipped, like the original
		y = x;
	else							// Narkowicz's fit to the ACES filmic curve
		y = (x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14);
	y = clamp(y, 0.0, 1.0);

	const float saturation = fr.output_f.x, contrast = fr.output_f.y;
	if (saturation != 1.0 || contrast != 1.0)
	{
		const float lum = Luminance(y);
		y = max(vec3(lum) + (y - vec3(lum)) * saturation, vec3(0.0));
		if (contrast != 1.0)
			y = 0.18 * pow(y * (1.0 / 0.18), vec3(contrast));	// pivots on mid grey
		y = min(y, vec3(1.0));
	}
	return y;
}

// the half size glow, between its four nearest pixels
vec3 Glow(ivec2 q)
{
	const ivec2 half_size = max(fr.size.xy / 2, ivec2(1));
	const vec2 f = (vec2(q) + 0.5) * 0.5 - 0.5;
	const ivec2 p0 = clamp(ivec2(floor(f)), ivec2(0), half_size - 1);
	const ivec2 p1 = min(p0 + 1, half_size - 1);
	const vec2 a = clamp(f - vec2(p0), 0.0, 1.0);
	return mix(mix(imageLoad(img_bloom[0], p0).rgb, imageLoad(img_bloom[0], ivec2(p1.x, p0.y)).rgb, a.x),
		mix(imageLoad(img_bloom[0], ivec2(p0.x, p1.y)).rgb, imageLoad(img_bloom[0], p1).rgb, a.x), a.y);
}

// the picture at a pixel, ready for the screen but for its encoding
vec3 Graded(ivec2 q)
{
	vec3 c = imageLoad(img_hdr, q).rgb;
	if (pass.glow != 0)
		c += Glow(q) * fr.output_f.z;
	return fr.settings2.w != 0 ? clamp(c, 0.0, 1.0) : ToneMap(c);
}

void main()
{
	const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	const ivec2 size = fr.size.xy;
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;
	const int now = fr.frame_has.z, prev = 1 - now;

	vec3 c = Graded(pixel);
	float frames = 1.0;

	if (fr.frame_has.w != 0 && fr.output_i.w != 0)
	{
		// where was this point on screen last frame?
		const vec3 v = imageLoad(img_seen, pixel).xyz - fr.prev_origin.xyz;
		const float z = dot(v, fr.prev_forward.xyz);
		const vec2 f = vec2((dot(v, fr.prev_right.xyz) / (z * fr.prev_origin.w) * 0.5 + 0.5) * size.x,
			(0.5 - dot(v, fr.prev_up.xyz) / (z * fr.prev_forward.w) * 0.5) * size.y) - 0.5;
		if (z > 0.01 && f.x > -0.5 && f.y > -0.5 && f.x < float(size.x) - 0.5 && f.y < float(size.y) - 0.5)
		{
			const ivec2 p0 = clamp(ivec2(floor(f)), ivec2(0), size - 1);
			const ivec2 p1 = min(p0 + 1, size - 1);
			const vec2 a = clamp(f - vec2(p0), 0.0, 1.0);
			vec4 was = mix(mix(imageLoad(img_steady[prev], p0), imageLoad(img_steady[prev], ivec2(p1.x, p0.y)), a.x),
				mix(imageLoad(img_steady[prev], ivec2(p0.x, p1.y)), imageLoad(img_steady[prev], p1), a.x), a.y);

			// what was there counts only as far as it could be this point
			// now: no brighter or darker than anything around it this frame
			vec3 lo = c, hi = c;
			for (int dy = -1; dy <= 1; dy++)
			{
				for (int dx = -1; dx <= 1; dx++)
				{
					if (dx == 0 && dy == 0)
						continue;
					const vec3 n = Graded(clamp(pixel + ivec2(dx, dy), ivec2(0), size - 1));
					lo = min(lo, n);
					hi = max(hi, n);
				}
			}
			was.rgb = clamp(was.rgb, lo, hi);

			// at rest the average may run on; on the move it has to keep up
			frames = min(was.a + 1.0, fr.output_f.w != 0.0 ? 256.0 : 8.0);
			c = mix(was.rgb, c, 1.0 / frames);
		}
	}

	imageStore(img_steady[now], pixel, vec4(c, frames));
	imageStore(img_picture, pixel, vec4(pow(c, vec3(1.0 / 2.2)), 1.0));
}
