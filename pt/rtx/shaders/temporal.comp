#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

// Blends this frame's samples into what earlier frames saw of the same
// surface: each point is looked up where it was on screen last frame, and
// what is found there counts if it was the same surface.
//
// Beside the light itself, the average of its brightness squared is kept the
// same way. From the two comes how much the samples behind a pixel have been
// disagreeing, which is how unsure its average still is: the filter that
// follows smooths by that, hard where the picture is noisy and hardly at all
// where it has settled.

layout(local_size_x = 8, local_size_y = 8) in;

#include "scene.glsl"

// Is what pixel q showed last frame the surface this pixel shows now: facing
// the same way and as far from the old eye as this point was?
bool SameSurface(ivec2 q, int prev, vec3 normal, float expected, out float frames)
{
	frames = 0.0;
	if (q.x < 0 || q.y < 0 || q.x >= fr.size.x || q.y >= fr.size.y)
		return false;
	const vec4 was = imageLoad(img_surface[prev], q);
	if (was.a < 0.0 || dot(was.xyz, normal) < 0.8 || abs(was.a - expected) > 0.1 * expected)
		return false;
	frames = imageLoad(img_m2[prev], q).a;
	return frames > 0.0;
}

void main()
{
	const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	const ivec2 size = fr.size.xy;
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;
	const int now = fr.frame_has.z, prev = 1 - now;

	const vec4 surface = imageLoad(img_surface[now], pixel);
	vec3 light[3];
	vec3 square;		// of each of the three, the mean square of its brightness
	for (int k = 0; k < 3; k++)
	{
		const vec4 sample_k = imageLoad(img_noisy[k], pixel);
		light[k] = sample_k.rgb;
		square[k] = sample_k.a;
	}

	if (surface.a < 0.0)
	{
		// nothing there to follow from frame to frame
		for (int k = 0; k < 3; k++)
			imageStore(img_kept[now * 3 + k], pixel, vec4(light[k], 0.0));
		imageStore(img_m2[now], pixel, vec4(square, 0.0));
		return;
	}

	const vec4 seen = imageLoad(img_seen, pixel);
	vec3 hist[3] = vec3[3](vec3(0.0), vec3(0.0), vec3(0.0));
	vec3 hist_square = vec3(0.0);
	float frames = 0.0, wsum = 0.0;

	if (fr.output_i.w != 0)
	{
		// where was this point on screen last frame?
		const vec3 v = seen.xyz - fr.prev_origin.xyz;
		const float z = dot(v, fr.prev_forward.xyz);
		if (z > 0.01)
		{
			// Less this frame's offset within the pixel: history belongs to
			// pixels, and with the eye at rest must come from the very same
			// one, or it would be resampled and crawl about every frame.
			const float fx = (dot(v, fr.prev_right.xyz) / (z * fr.prev_origin.w) * 0.5 + 0.5) * size.x - 0.5 - fr.right.w;
			const float fy = (0.5 - dot(v, fr.prev_up.xyz) / (z * fr.prev_forward.w) * 0.5) * size.y - 0.5 - fr.up.w;
			const ivec2 corner = ivec2(floor(vec2(fx, fy) + 0.001));
			const vec2 a = vec2(fx, fy) - vec2(corner);
			const float expected = length(v);
			// Where frames are only added up with the eye at rest, a point
			// that was somewhere else on screen is something that moves: it
			// starts afresh, so that nothing of where it was shows.
			const bool elsewhere = fr.bases.z == 1 && (abs(fx - float(pixel.x)) > 0.01 || abs(fy - float(pixel.y)) > 0.01);

			for (int t = 0; t < 4 && !elsewhere; t++)
			{
				const ivec2 q = corner + ivec2(t & 1, t >> 1);
				float f;
				if (!SameSurface(q, prev, surface.xyz, expected, f))
					continue;
				const float w = ((t & 1) != 0 ? a.x : 1.0 - a.x) * ((t >> 1) != 0 ? a.y : 1.0 - a.y);
				if (w <= 0.0)
					continue;
				for (int k = 0; k < 3; k++)
					hist[k] += imageLoad(img_kept[prev * 3 + k], q).rgb * w;
				hist_square += imageLoad(img_m2[prev], q).rgb * w;
				frames += f * w;
				wsum += w;
			}

			if (wsum <= 0.01 && !elsewhere)
			{
				// Nothing usable right where this point was. Along an edge a
				// pixel shows one surface on some frames and its neighbour
				// on others: look a little wider for more of this one.
				wsum = 0.0;
				frames = 0.0;
				const ivec2 spot = ivec2(floor(vec2(fx, fy) + 0.5));
				for (int dy = -1; dy <= 1; dy++)
				{
					for (int dx = -1; dx <= 1; dx++)
					{
						const ivec2 q = spot + ivec2(dx, dy);
						float f;
						if (!SameSurface(q, prev, surface.xyz, expected, f))
							continue;
						for (int k = 0; k < 3; k++)
							hist[k] += imageLoad(img_kept[prev * 3 + k], q).rgb;
						hist_square += imageLoad(img_m2[prev], q).rgb;
						frames += f;
						wsum += 1.0;
					}
				}
			}
		}
	}

	// with nothing changing the average may run on and converge
	const bool still = fr.output_f.w != 0.0;
	const float moving_history = float(max(fr.output_i.z, 1));
	const float max_history = still ? 2048.0 : moving_history;

	float kept_frames = 1.0;
	if (wsum > 0.01)
	{
		const float inv = 1.0 / wsum;
		kept_frames = min(frames * inv + 1.0, max_history);
		for (int k = 0; k < 3; k++)
		{
			// a mirror shows something else as soon as the eye moves, so
			// smooth reflections keep less of the past while things change
			float keep = kept_frames;
			if (k == 1 && !still)
				keep = min(kept_frames, max(2.0, moving_history * seen.a * 2.0));
			light[k] = mix(hist[k] * inv, light[k], 1.0 / keep);
			square[k] = mix(hist_square[k] * inv, square[k], 1.0 / keep);
		}
	}

	// How unsure each average still is: how far its samples have spread about
	// it, less for every frame that stands behind it. With next to no history
	// the spread itself is not known yet, so assume the worst.
	for (int k = 0; k < 3; k++)
	{
		const float mean = Luminance(light[k]);
		float unsure = max(0.0, square[k] - mean * mean) / kept_frames;
		if (kept_frames < 4.0)
			unsure = max(unsure, mean * mean * 0.25 + 0.01);
		imageStore(img_kept[now * 3 + k], pixel, vec4(light[k], unsure));
	}
	imageStore(img_m2[now], pixel, vec4(min(square, vec3(60000.0)), kept_frames));
}
